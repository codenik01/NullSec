configuration { font: "JetBrains Mono 11"; show-icons: false; }
* { bg: #0a0a0a; fg: #c8c8c8; ac: #e5484d;
    background-color: @bg; text-color: @fg; margin: 0; padding: 0; spacing: 0; }
window { width: 560px; border: 1px; border-color: @ac; }
mainbox { padding: 10px; }
inputbar { padding: 6px; children: [prompt, entry]; }
prompt { text-color: @ac; padding: 0 8px 0 0; }
listview { lines: 12; padding: 6px 0 0 0; scrollbar: false; }
element { padding: 4px 6px; }
element selected { background-color: @ac; text-color: @bg; }
