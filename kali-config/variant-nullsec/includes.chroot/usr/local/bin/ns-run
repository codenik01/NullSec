#!/usr/bin/env bash
# ns-run <cmd> [package]  -- run a tool's help; offer to install if missing
cmd=$1; pkg=${2:-$1}
if ! command -v "$cmd" >/dev/null 2>&1; then
  printf '%s is not installed. install package "%s"? [y/N] ' "$cmd" "$pkg"; read -r a
  if [ "$a" = y ]; then sudo apt-get update -qq && sudo apt-get install -y --no-install-recommends "$pkg"; else exit 1; fi
fi
echo "\$ $cmd --help"; "$cmd" --help 2>&1 | head -40
exec zsh
