#!/usr/bin/env bash
# Collects input/session info into ~/nullsec-diag.txt so problems can be pinned down in one go.
O=~/nullsec-diag.txt
{
echo "== date/arch =="; date; uname -m; uname -r
echo "== virt =="; systemd-detect-virt 2>&1
echo "== session =="; echo "$XDG_SESSION_TYPE $DESKTOP_SESSION"; loginctl list-sessions 2>&1
echo "== input devices (xinput) =="; xinput list 2>&1
echo "== input devices (kernel) =="; grep -E 'Name=|Handlers=' /proc/bus/input/devices
echo "== keyboard =="; setxkbmap -query 2>&1
echo "== running ui =="; pgrep -a 'openbox|i3|tint2|lightdm|Xorg' 2>&1
echo "== lightdm log (tail) =="; tail -n 30 /var/log/lightdm/lightdm.log 2>&1
echo "== xsession-errors (tail) =="; tail -n 30 ~/.xsession-errors 2>&1
echo "== guest tools =="; systemctl is-active open-vm-tools spice-vdagent qemu-guest-agent 2>&1
} > "$O" 2>&1
cat "$O"; echo; echo "saved to $O"; read -r -p "press enter" _
