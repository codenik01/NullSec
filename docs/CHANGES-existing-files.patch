+    [ $n -eq 0 ] && echo "waiting for another package operation (the system updater) to finish..." >&2
+    n=$((n+1)); [ $n -gt 180 ] && { echo "the package system is still busy after 6 minutes; try again in a moment" >&2; return 1; }
