[Unit]
Description=Give the desktop user access to sound and video devices
Before=display-manager.service
After=local-fs.target

[Service]
Type=oneshot
ExecStart=/bin/sh -c 'for u in $(getent passwd | awk -F: "\\$3>=1000 && \\$3<60000 {print \\$1}"); do usermod -aG audio,video "$u"; done'

[Install]
WantedBy=multi-user.target
