{
  "schema": 1,
  "id": "privacy-focused",
  "name": "Privacy-Focused",
  "version": "1.0.0",
  "description": "Restricted Network plus: DNS pinned to Quad9 (edit servers to use your own), random MAC addresses on Wi-Fi and Ethernet (applied on reconnect), no ICMP out, and desktop mounting of USB storage disabled. Reduces exposure; it does not make you anonymous.",
  "on_failure": "report",
  "controls": {
    "outbound": { "enabled": true, "required": true, "default": "drop",
                  "allow_tcp": [80, 443], "allow_udp": [123], "allow_hosts": [],
                  "allow_icmp": false, "vpn_interfaces": ["tun*", "wg*"] },
    "inbound":  { "enabled": true, "required": true, "drop_new_on_vpn": true, "allow_ping": false },
    "dns":      { "enabled": true, "required": true, "mode": "pinned",
                  "servers": ["9.9.9.9", "149.112.112.112", "2620:fe::fe", "2620:fe::9"],
                  "block_dot": true, "allow_via_vpn": true },
    "ipv6":     { "enabled": true, "required": true, "mode": "same" },
    "mac":      { "enabled": true, "required": false, "wifi": "random", "ethernet": "random", "reconnect": true },
    "usb_storage": { "enabled": true, "required": false, "mode": "block-desktop-mount" },
    "monitor":  { "enabled": true, "required": false, "interval": 30 }
  }
}
