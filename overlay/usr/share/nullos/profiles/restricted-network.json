{
  "schema": 1,
  "id": "restricted-network",
  "name": "Restricted Network",
  "version": "1.0.0",
  "description": "Recommended baseline. Outbound default-deny: only web (80/443), NTP and DNS to the resolvers you actually use are allowed, plus everything inside a VPN tunnel (tun*/wg*). Inbound new connections are blocked (including on the VPN). DNS leaks to other resolvers and DNS-over-TLS are blocked. IPv4 and IPv6 get the same policy.",
  "on_failure": "report",
  "controls": {
    "outbound": { "enabled": true, "required": true, "default": "drop",
                  "allow_tcp": [80, 443], "allow_udp": [123], "allow_hosts": [],
                  "allow_icmp": true, "vpn_interfaces": ["tun*", "wg*"] },
    "inbound":  { "enabled": true, "required": true, "drop_new_on_vpn": true, "allow_ping": false },
    "dns":      { "enabled": true, "required": true, "mode": "system", "servers": [],
                  "block_dot": true, "allow_via_vpn": true },
    "ipv6":     { "enabled": true, "required": true, "mode": "same" },
    "mac":      { "enabled": false, "required": false, "wifi": "random", "ethernet": "random", "reconnect": true },
    "monitor":  { "enabled": true, "required": false, "interval": 30 }
  }
}
