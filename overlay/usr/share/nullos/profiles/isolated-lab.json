{
  "schema": 1,
  "id": "isolated-lab",
  "name": "Isolated Lab",
  "version": "1.0.0",
  "description": "Separates the host from the outside world while you work in a lab: no internet (all outbound denied except the local lab network 10.77.0.0/16 and loopback), IPv6 blocked, guest clipboard sharing stopped, desktop USB-storage mounting disabled, random MACs. If the firewall cannot be verified, the service falls back to a full network deny.",
  "on_failure": "fallback-deny",
  "controls": {
    "outbound": { "enabled": true, "required": true, "default": "drop",
                  "allow_tcp": [], "allow_udp": [], "allow_hosts": ["10.77.0.0/16"],
                  "allow_icmp": false, "vpn_interfaces": [] },
    "inbound":  { "enabled": true, "required": true, "drop_new_on_vpn": true, "allow_ping": false },
    "ipv6":     { "enabled": true, "required": true, "mode": "block" },
    "mac":      { "enabled": true, "required": false, "wifi": "random", "ethernet": "random", "reconnect": true },
    "usb_storage": { "enabled": true, "required": false, "mode": "block-desktop-mount" },
    "clipboard": { "enabled": true, "required": false, "mode": "block" },
    "monitor":  { "enabled": true, "required": false, "interval": 20 }
  }
}
