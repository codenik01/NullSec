#!/usr/bin/python3
"""NullOS security service entry point. usage: nullos-secd [--selftest]"""
import os, sys
sys.path.insert(0, os.environ.get("NULLOS_LIB", "/usr/lib/nullos"))
from secd import service
if __name__ == "__main__":
    if "--selftest" in sys.argv:
        service.selftest()
    else:
        service.serve()
