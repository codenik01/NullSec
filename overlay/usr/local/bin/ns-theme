#!/usr/bin/env bash
unset DESKTOP_STARTUP_ID
# ns-theme [red|blue|green|<hex>]  -- recolours panel, borders, menus, terminal, GTK apps, prompt, logo
C=~/.config/nullsec; mkdir -p "$C"
declare -A P=([red]=e5484d [blue]=4c8dff [green]=3ecf8e)
cur=$(cat "$C/accent" 2>/dev/null || echo e5484d)
n=${1:-}
[ -n "$n" ] || n=$(printf 'red\nblue\ngreen\n' | rofi -dmenu -p theme) || exit 0
new=${P[$n]:-${n#\#}}
[[ $new =~ ^[0-9a-fA-F]{6}$ ]] || { echo "usage: ns-theme red|blue|green|<hex>"; exit 1; }
new=$(tr 'A-F' 'a-f' <<<"$new")
for f in ~/.themes/nullsec/openbox-3/themerc ~/.config/tint2/tint2rc ~/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-terminal.xml ~/.config/gtk-3.0/gtk.css \
         ~/.local/share/rofi/themes/nullsec.rasi ~/.config/dunst/dunstrc ~/.config/i3/config ~/.tmux.conf ~/.zshrc; do
  [ -f "$f" ] && sed -i "s/#$cur/#$new/Ig" "$f"
done
echo "$new" > "$C/accent"
xfconf-query -c xfce4-terminal -p /color-cursor -s "#$new" 2>/dev/null
ns-logo "$new"
[ "$(cat "$C/wallpaper" 2>/dev/null)" = plain ] && ns-wallpaper plain
openbox --reconfigure 2>/dev/null; i3-msg reload >/dev/null 2>&1
pkill -x tint2 2>/dev/null; (setsid tint2 >/dev/null 2>&1 &)
pkill -x dunst 2>/dev/null; (setsid dunst >/dev/null 2>&1 &)
tmux source-file ~/.tmux.conf 2>/dev/null
notify-send "theme" "accent #$new" 2>/dev/null; echo "theme: #$new  (open a new terminal for the prompt/terminal colours)"
