#!/usr/bin/env bash
unset DESKTOP_STARTUP_ID
# ns-transparency                         menu (also: Settings > Transparency)
# ns-transparency preset opaque|subtle|glass|max
# ns-transparency set windows|terminal|panel|menus|notifications <30-100>     (100 = fully opaque)
# ns-transparency show | reset
# windows = every window (the focused one; others are 7 points lower)   terminal = terminal windows only
# panel = top bar   menus = launcher / start menu (rofi)   notifications = pop-ups
# Needs the compositor (picom); turning transparency on also turns the effects on if they were off.
C=~/.config/nullsec; F=$C/transparency; mkdir -p "$C" ~/.config/picom
declare -A V=([windows]=100 [terminal]=100 [panel]=100 [menus]=100 [notifications]=100)
[ -f "$F" ] && while IFS='=' read -r k v; do [[ $k =~ ^(windows|terminal|panel|menus|notifications)$ && $v =~ ^[0-9]{2,3}$ ]] && V[$k]=$v; done < "$F"
save() { : > "$F"; for k in windows terminal panel menus notifications; do echo "$k=${V[$k]}" >> "$F"; done; }
pc() { awk -v p="$1" 'BEGIN{printf "%.2f", p/100}'; }
hexa() { printf '%02x' "$(( ($1 * 255 + 50) / 100 ))"; }

apply_picom() {
  local act=${V[windows]} ina=$(( V[windows] - 7 )); [ $ina -lt 30 ] && ina=30
  local rules=""; [ "${V[terminal]}" -lt 100 ] && rules="opacity-rule = [ \"${V[terminal]}:class_g = 'Xfce4-terminal'\" ];"
  cat > ~/.config/picom/picom.conf <<PICOM
# generated by ns-transparency (Settings > Transparency). Conservative: works without GPU/GL (VMs). Turn all effects off: ns-fx off
backend = "xrender";
vsync = false;
shadow = false;
fading = true;
fade-in-step = 0.07;
fade-out-step = 0.07;
fade-delta = 8;
inactive-opacity = $(pc $ina);
active-opacity = $(pc $act);
frame-opacity = 1.0;
detect-client-opacity = true;
mark-wmwin-focused = true;
mark-ovredir-focused = true;
use-ewmh-active-win = true;
wintypes: {
  dock = { opacity = 1.0; };
  popup_menu = { opacity = 1.0; };
  dropdown_menu = { opacity = 1.0; };
  notification = { opacity = 1.0; };
};
$rules
PICOM
}
apply_panel() { local f=~/.config/tint2/tint2rc; [ -f "$f" ] && sed -i "0,/^background_color = #\([0-9a-fA-F]\{6\}\) [0-9]\{1,3\}/s//background_color = #\1 ${V[panel]}/" "$f"; }
apply_menus() { local f=~/.local/share/rofi/themes/nullsec.rasi; [ -f "$f" ] && sed -i "s/bga: #\([0-9a-fA-F]\{6\}\)\([0-9a-fA-F]\{2\}\)\{0,1\};/bga: #\1$(hexa "${V[menus]}");/" "$f"; }
apply_notif() { local f=~/.config/dunst/dunstrc; [ -f "$f" ] || return 0; local t=$(( 100 - V[notifications] ))
  if grep -q '^transparency *=' "$f"; then sed -i "s/^transparency *=.*/transparency = $t/" "$f"; else sed -i "0,/^\[global\]/s//[global]\ntransparency = $t/" "$f"; fi; }

# stop a program and WAIT until it has really exited before starting it again: a compositor that starts while the old one
# is still shutting down refuses to run ("another compositor is running") and the desktop is left without one
restart() { local n=$1; shift; pkill -x "$n" 2>/dev/null; for _ in $(seq 40); do pgrep -x "$n" >/dev/null 2>&1 || break; sleep 0.1; done; (setsid "$@" >/dev/null 2>&1 &); }
apply() {
  apply_picom; apply_panel; apply_menus; apply_notif; save
  local any=0; for k in "${!V[@]}"; do [ "${V[$k]}" -lt 100 ] && any=1; done
  [ -n "${NS_TRANSPARENCY_NORESTART:-}" ] && return 0
  if [ $any = 1 ]; then rm -f "$C/nofx"; fi
  if [ ! -f "$C/nofx" ]; then restart picom picom --config ~/.config/picom/picom.conf -b; fi
  restart tint2 tint2
  restart dunst dunst
}
valid() { [[ $1 =~ ^[0-9]{2,3}$ ]] && [ "$1" -ge 30 ] && [ "$1" -le 100 ]; }
preset() { case "$1" in
  opaque) V=([windows]=100 [terminal]=100 [panel]=100 [menus]=100 [notifications]=100);;
  subtle) V=([windows]=100 [terminal]=92 [panel]=90 [menus]=94 [notifications]=92);;
  glass)  V=([windows]=94 [terminal]=85 [panel]=75 [menus]=88 [notifications]=85);;
  max)    V=([windows]=85 [terminal]=70 [panel]=55 [menus]=78 [notifications]=75);;
  *) echo "presets: opaque subtle glass max"; return 1;; esac; }
show() { for k in windows terminal panel menus notifications; do printf '%-14s %s%%\n' "$k" "${V[$k]}"; done; }
level() { printf '%s\n' "100% (opaque)" 95% 90% 85% 80% 70% 60% 50% 40% | rofi -dmenu -p "$1 opacity" | tr -dc '0-9'; }

case "${1:-menu}" in
  preset) preset "${2:-}" || exit 1; apply; show;;
  set) [[ ${2:-} =~ ^(windows|terminal|panel|menus|notifications)$ ]] && valid "${3:-}" || { echo "usage: ns-transparency set windows|terminal|panel|menus|notifications <30-100>"; exit 1; }
       V[$2]=$3; apply; show;;
  reset) preset opaque; apply; show;;
  show) show;;
  menu)
    while :; do
      c=$(printf '%s\n' "Whole desktop: opaque (off)" "Whole desktop: subtle" "Whole desktop: glass" "Whole desktop: maximum glass" \
          "Windows ...        (${V[windows]}%)" "Terminal ...       (${V[terminal]}%)" "Top bar ...        (${V[panel]}%)" "Menus & launcher ... (${V[menus]}%)" "Notifications ...  (${V[notifications]}%)" "Done" | rofi -dmenu -i -p transparency) || exit 0
      case "$c" in
        *opaque*) preset opaque; apply;; *subtle*) preset subtle; apply;; *"glass"*"maximum"*|*maximum*) preset max; apply;; *glass*) preset glass; apply;;
        Windows*) l=$(level windows) && valid "$l" && { V[windows]=$l; apply; };;
        Terminal*) l=$(level terminal) && valid "$l" && { V[terminal]=$l; apply; };;
        "Top bar"*) l=$(level panel) && valid "$l" && { V[panel]=$l; apply; };;
        Menus*) l=$(level menus) && valid "$l" && { V[menus]=$l; apply; };;
        Notifications*) l=$(level notifications) && valid "$l" && { V[notifications]=$l; apply; };;
        *) exit 0;;
      esac
    done;;
  *) sed -n '3,9p' "$0" | sed 's/^# \?//'; exit 2;;
esac
