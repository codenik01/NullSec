#!/usr/bin/env bash
unset DESKTOP_STARTUP_ID
# ns-offline: what works with NO internet. Three separate questions (they are not the same thing):
#   1 live environment   2 offline installation   3 offline operation of the installed system
echo "NullOS offline readiness  (checked on this machine, no network used)"; echo
echo "1. Live environment"
miss=0; for b in i3 tint2 rofi xfce4-terminal thunar mousepad firefox nmap tcpdump nft nmcli python3 gdb radare2 binwalk zsh tmux; do
  command -v "$b" >/dev/null 2>&1 || { echo "   missing: $b"; miss=$((miss+1)); }; done
[ $miss -eq 0 ] && echo "   OK: all bundled applications are present on the image" || echo "   $miss bundled application(s) missing"
echo "2. Offline installation"; echo "   supported: Install NullOS (start menu, live session only) copies the system from the ISO and installs GRUB from the image; nothing is downloaded"
echo "3. Offline operation"
echo "   works offline : desktop, terminal, bundled tools, firewall, Security Center, ns-sandbox, ns-lab (namespaces)"
echo "   needs internet: ns-pack install/search (package index), updates, Firefox sync, ns-install tools"
if ls /var/lib/apt/lists/*Packages* >/dev/null 2>&1; then echo "   package index : present"; else echo "   package index : ABSENT (stripped to keep the image small): run ns-pack update when online"; fi
