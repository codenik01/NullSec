#!/usr/bin/env bash
# started by both sessions; every program is started only if not already running
exec 9>/tmp/.ns-autostart.lock; flock 9
run() { pgrep -x "$1" >/dev/null 2>&1 || ( "$@" >/dev/null 2>&1 & ); }
xsetroot -cursor_name left_ptr
[ -f ~/.Xresources ] && xrdb -merge ~/.Xresources
ns-wallpaper restore
run dunst
run xfsettingsd
run tint2
run nm-applet
run spice-vdagent
run xfce4-power-manager
if [ ! -f ~/.config/nullsec/nofx ]; then run picom --config ~/.config/picom/picom.conf -b; fi
if [ "$DESKTOP_SESSION" = i3 ] || pgrep -x i3 >/dev/null; then
  pgrep -fx 'python3 /usr/local/bin/ns-autotile' >/dev/null || ( python3 /usr/local/bin/ns-autotile >/dev/null 2>&1 & )
fi
exit 0
