#!/usr/bin/env bash
unset DESKTOP_STARTUP_ID
# ns-bootfix : tidy and repair the UEFI boot of an INSTALLED NullOS.
#   sudo ns-bootfix                       installed system: drop stale firmware entries (the removed ISO / USB),
#                                         make NullOS the first boot entry, check grub.cfg and the ESP
#   sudo ns-bootfix --repair              the above + reinstall GRUB and regenerate grub.cfg
#   sudo ns-bootfix --live /dev/ROOT [/dev/ESP]
#                                         from the LIVE ISO: repair an installed system that does not boot (e.g. /dev/vda2 /dev/vda1)
#   (--post-install is used by the installer, in the target chroot; it never fails the install)
# The "BdsDxe: failed to load Boot0001 ... USB HARDDRIVE ... Not Found" line is the firmware complaining about a stale entry
# for the removed ISO. Deleting that entry removes the message and the delay it causes.
mode=${1:-fix}
say() { [ "$mode" = --post-install ] || echo "$*"; }
[ "$(id -u)" -eq 0 ] || { echo "run with sudo"; exit 1; }

if [ "$mode" = --live ]; then
  root=${2:-}; esp=${3:-}; [ -b "$root" ] || { echo "usage: sudo ns-bootfix --live /dev/ROOT_PARTITION [/dev/EFI_PARTITION]"; exit 1; }
  [ -n "$esp" ] || esp=$(lsblk -prno NAME,PARTTYPE | awk 'tolower($2)=="c12a7328-f81f-11d2-ba4b-00a0c93ec93b"{print $1; exit}')
  [ -b "$esp" ] || { echo "cannot find the EFI system partition; pass it as the 2nd argument"; exit 1; }
  T=/mnt/nullos-target; mkdir -p "$T"; mount "$root" "$T" && mkdir -p "$T/boot/efi" && mount "$esp" "$T/boot/efi" || { echo "mount failed"; exit 1; }
  for m in dev dev/pts proc sys run; do mount --bind "/$m" "$T/$m"; done
  mount -t efivarfs efivarfs "$T/sys/firmware/efi/efivars" 2>/dev/null || true
  # the script may not exist inside an older install: copy this one in
  cp "$0" "$T/usr/local/bin/ns-bootfix"; chmod +x "$T/usr/local/bin/ns-bootfix"
  chroot "$T" /usr/local/bin/ns-bootfix --repair; rc=$?
  for m in sys/firmware/efi/efivars run sys proc dev/pts dev boot/efi; do umount -l "$T/$m" 2>/dev/null; done; umount -l "$T" 2>/dev/null
  echo "done (exit $rc). Remove the ISO and restart the VM."; exit $rc
fi

[ -d /sys/firmware/efi ] || { say "BIOS boot: no UEFI entries to fix."; [ "$mode" = --repair ] && { d=$(findmnt -no SOURCE / | sed 's/p\?[0-9]*$//'); grub-install "$d" && update-grub; }; exit 0; }
case "$(uname -m)" in aarch64) A=aa64; TGT=arm64-efi;; *) A=x64; TGT=x86_64-efi;; esac

if [ "$mode" = --repair ]; then
  say "reinstalling GRUB ($TGT) and regenerating grub.cfg..."
  grub-install --target="$TGT" --efi-directory=/boot/efi --bootloader-id=NullOS --force 2>&1 | tail -3
  update-grub 2>&1 | tail -3
fi
if ! grep -q '^menuentry' /boot/grub/grub.cfg 2>/dev/null; then say "grub.cfg missing or empty: regenerating"; update-grub >/dev/null 2>&1 || grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1; fi

if command -v efibootmgr >/dev/null; then
  # 1. NullOS entry must exist (re-create it if only the files are there)
  if ! efibootmgr 2>/dev/null | grep -q 'NullOS'; then
    ef=$(findmnt -no SOURCE /boot/efi 2>/dev/null)
    if [ -n "$ef" ] && [ -f "/boot/efi/EFI/NullOS/shim$A.efi" ]; then
      disk=/dev/$(lsblk -no PKNAME "$ef"); part=$(cat "/sys/class/block/$(basename "$ef")/partition" 2>/dev/null)
      efibootmgr -c -d "$disk" -p "$part" -L NullOS -l "\\EFI\\NullOS\\shim$A.efi" >/dev/null 2>&1 && say "re-created the NullOS boot entry"
    fi
  fi
  # 2. delete stale entries the FIRMWARE made for removable media (the ISO / USB stick / CD that is no longer there).
  #    Only auto-generated "UEFI ..." USB/CD/DVD entries are touched; NullOS and any other OS entry stay.
  efibootmgr 2>/dev/null | sed -nE 's/^Boot([0-9A-Fa-f]{4})\*? (UEFI .*(USB|CD|DVD|ISO|CDROM).*)$/\1 \2/Ip' | while read -r n label; do
    case "$label" in *NullOS*) continue;; esac
    efibootmgr -b "$n" -B >/dev/null 2>&1 && say "removed stale boot entry Boot$n ($label)"
  done
  # 3. NullOS first
  n=$(efibootmgr 2>/dev/null | sed -nE 's/^Boot([0-9A-Fa-f]{4})\*? NullOS.*/\1/p' | head -1)
  if [ -n "$n" ]; then
    rest=$(efibootmgr 2>/dev/null | sed -nE 's/^BootOrder: (.*)/\1/p' | tr ',' '\n' | grep -vix "$n" | paste -sd, -)
    efibootmgr -o "$n${rest:+,$rest}" >/dev/null 2>&1 && say "boot order: NullOS first"
  fi
fi
# 4. the ESP must hold the loaders GRUB needs
miss=0; for f in shim$A.efi grub$A.efi; do [ -f "/boot/efi/EFI/NullOS/$f" ] || { say "WARNING: /boot/efi/EFI/NullOS/$f is missing (run: sudo ns-bootfix --repair)"; miss=1; }; done
[ $miss = 0 ] && say "boot files OK"
exit 0
