#!/usr/bin/env bash
unset DESKTOP_STARTUP_ID
a=$(printf '%s\n' "Lock" "Log out" "Reboot" "Power off" | rofi -dmenu -i -p power) || exit 0
case "$a" in
  Lock) i3lock -c 0a0a0a;;
  "Log out") loginctl terminate-session "${XDG_SESSION_ID:-self}" 2>/dev/null || pkill -u "$USER" -x "i3|openbox";;
  Reboot) systemctl reboot || sudo systemctl reboot;;
  "Power off") systemctl poweroff || sudo systemctl poweroff;;
esac
