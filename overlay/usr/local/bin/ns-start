#!/usr/bin/env bash
unset DESKTOP_STARTUP_ID
# NullOS start menu (logo button / Super+Space): apps, settings, power. Everything is clickable.
sub() { rofi -dmenu -i -p "$1"; }
c=$(printf '%s\n' "Applications" "Files" "Terminal" "Browser" "Text editor" "Calculator" "PDF viewer" "Images" "Archives" "Task manager" "Screenshot" "Security tools" "Network / Wi-Fi" "Settings >" "Power >" | sub nullos) || exit 0
case "$c" in
  Applications) exec rofi -show drun;;
  Files) exec thunar;;
  Terminal) exec ns-term;;
  Browser) exec ns-browser;;
  "Text editor") exec mousepad;;
  Calculator) exec mate-calc;;
  "PDF viewer") exec atril;;
  Images) exec ristretto;;
  Archives) exec engrampa;;
  "Task manager") exec xfce4-taskmanager;;
  Screenshot) exec xfce4-screenshooter;;
  "Security tools") exec ns-menu;;
  "Network / Wi-Fi") exec ns-net;;
  "Settings >") exec ns-settings;;
  "Power >") exec ns-power;;
esac
