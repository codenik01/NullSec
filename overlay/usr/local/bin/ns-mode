#!/usr/bin/env bash
unset DESKTOP_STARTUP_ID
# ns-mode [tiling|floating] : switch between i3 (tiling) and Openbox (floating, title bars); the desktop restarts to apply
m=${1:-}
[ -n "$m" ] || m=$(printf '%s\n' tiling floating | rofi -dmenu -p "layout (desktop restarts to apply)") || exit 0
case "$m" in tiling) s=i3;; floating) s=openbox;; *) echo "usage: ns-mode tiling|floating"; exit 1;; esac
mkdir -p ~/.config/nullsec && echo "$m" > ~/.config/nullsec/mode
notify-send "layout" "$m - restarting the desktop..." 2>/dev/null; sleep 1
# --apply restarts LightDM so the new session is really used (a plain logout re-used the old one)
sudo ns-session "$s" --apply || { notify-send "layout" "could not switch ($s)" 2>/dev/null; exit 1; }
