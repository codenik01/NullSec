#!/usr/bin/env bash
# grub-install wrapper used by the installer (bootloader.conf: grubInstall) and by ns-bootfix.
# Secure Boot OFF (UTM/QEMU/most VMs and many PCs): install the plain, unsigned GRUB straight into the firmware entry.
#   It is the same GRUB build as the live ISO menu, so the themed menu behaves exactly like the live one and there is no shim
#   in between (the signed shim+GRUB chain was where a VM could sit on the firmware logo after "starting Boot... shimaa64.efi").
# Secure Boot ON: use the signed shim + GRUB chain (default grub-install behaviour).
sb=0
for v in /sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c; do
  [ -r "$v" ] && [ "$(od -An -t u1 -j4 -N1 "$v" 2>/dev/null | tr -d ' ')" = 1 ] && sb=1
done
if [ $sb = 1 ]; then exec grub-install "$@"; else exec grub-install --no-uefi-secure-boot "$@"; fi
