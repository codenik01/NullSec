#!/usr/bin/env bash
unset DESKTOP_STARTUP_ID
# NullOS Security Center (Super+S). A front-end only: runs as YOUR user and asks the security
# service (nullos-secd) for every change. It shows what the system confirms, nothing it assumes.
sec() { ns-secure "$@"; }
menu() { rofi -dmenu -i -p "$1" ${2:+-mesg "$2"}; }
term() { ns-term sh -c "$* ; echo; printf 'press enter to close '; read -r _"; }
yesno() { [ "$(printf 'no\nyes\n' | menu "$1")" = yes ]; }

header() {   # compact status text for the rofi message line (takes the status JSON, or fetches it)
  local j=${1:-}; [ -n "$j" ] || j=$(sec status --json 2>/dev/null) || return 1
  jq -r '
    def l: ascii_upcase;
    "RESTRICTED MODE: " + (if .mode=="restricted" then "ON (" + (.overall|l) + ")" else "OFF" end)
    + "   Profile: " + .profile_name
    + (if .kill then "   EMERGENCY DISCONNECT ENGAGED" else "" end),
    ( .checks | map(select(.id|test("^(net\\.(outbound|inbound|dns|ipv6|mac|ruleset)|sys\\.(firewall|apparmor|sysctl|config|monitor)|host\\.)")))
      | map("  " + (.title) + ": " + (.status|l)) | join("\n") ),
    ( [.checks[]|select(.area=="labs")] | "  Labs: " + (length|tostring) + " active" )' <<<"$j"
}

custom() {
  while :; do
    local j; j=$(sec custom show --json) || return
    local lines; lines=$(jq -r '.toggles|to_entries[]|"\(.key)\t\(.value)"' <<<"$j")
    local pick; pick=$( { while IFS=$'\t' read -r k v; do
        case "$v" in true) printf '[x] %s\n' "$k";; false) printf '[ ] %s\n' "$k";; *) printf '[%s] %s\n' "$v" "$k";; esac; done <<<"$lines"
      echo "-- save and apply"; echo "-- save only"; echo "-- back"; } | menu "custom controls (select to change)" \
      "outbound=restrict to web/NTP  inbound=block new  dns=system|quad9|off  ipv6=same|block  mac=randomize  usb_storage/clipboard=VM+USB  allow_ssh=add tcp 22") || return
    case "$pick" in
      "-- back"*) return;;
      "-- save only"*) notify-send "security" "custom profile saved" 2>/dev/null; return;;
      "-- save and apply"*) term "ns-secure enable custom"; return;;
      *) k=${pick#* }; cur=$(jq -r --arg k "$k" '.toggles[$k]' <<<"$j")
         case "$cur" in
           true) sec custom "$k=off" >/dev/null;;
           false) sec custom "$k=on" >/dev/null;;
           *) mapfile -t ch < <(jq -r --arg k "$k" '.choices[$k][]' <<<"$j"); nv=$(printf '%s\n' "${ch[@]}" | menu "$k") && sec custom "$k=$nv" >/dev/null;;
         esac;;
    esac
  done
}

labs() {
  local c; c=$(printf '%s\n' "Disposable workspace (empty home, no network)" "Analysis lab for a file..." "Create network lab (2 nodes)" "Destroy a network lab..." "Lab status" "Isolation backends (doctor)" "Tool packs..." | menu labs) || return
  case "$c" in
    Disposable*) exec ns-term ns-lab workspace;;
    Analysis*) f=$(menu "path of the file to analyse" < /dev/null) && [ -f "$f" ] && exec ns-term ns-lab analyze "$f";;
    Create*) id=$(menu "lab id (a-z, 1-8 chars)" < /dev/null) && [ -n "$id" ] && term "ns-lab net create '$id' 2";;
    Destroy*) id=$(sec status 2>/dev/null | awk '/Lab [a-z0-9]+ /{print $2}' | menu "destroy which lab") && [ -n "$id" ] && yesno "destroy lab $id?" && term "ns-lab net destroy '$id'";;
    "Lab status") term "ns-lab net list";;
    Isolation*) term "ns-lab doctor";;
    Tool*) p=$(ns-pack profiles 2>/dev/null | awk '{print $1}' | menu "install tool pack") && [ -n "$p" ] && term "ns-pack install $p";;
  esac
}

audits() {
  local a; a=$(printf '%s\n' all users credentials environment privileged listening services config packages updates mounts sudo apparmor | menu audit) || return
  term "ns-secure audit $a | less -R"
}

main() {
  while :; do
    local hdr mode kill j
    if ! j=$(sec status --json 2>/dev/null) || ! hdr=$(header "$j"); then
      c=$(printf '%s\n' "Start the security service" "Cancel" | menu "security service is NOT running" "Protections cannot be verified. Rules already loaded in the kernel stay in force.") || exit 0
      [ "$c" = "Start the security service" ] && term "sudo systemctl start nullos-secd; ns-secure status"; continue
    fi
    mode=$(jq -r .mode <<<"$j"); kill=$(jq -r .kill <<<"$j")
    local toggle="Turn Restricted Mode ON (recommended profile)"; [ "$mode" = restricted ] && toggle="Turn Restricted Mode OFF (back to Standard)"
    local ek="Emergency Disconnect"; [ "$kill" = true ] && ek="Release Emergency Disconnect"
    c=$(printf '%s\n' "$toggle" "Profiles..." "Custom controls..." "$ek" "Verify now" "View changes" "Security log" "Network connections" "Listening services" "IP & routes (and VPN leak check)" "MAC address state" "Audits..." "Labs and tool packs..." "Restore defaults" | menu "security" "$hdr") || exit 0
    case "$c" in
      "Turn Restricted Mode ON"*) term "ns-secure enable restricted-network";;
      "Turn Restricted Mode OFF"*) term "ns-secure disable";;
      Profiles*) p=$(sec profiles | awk '/^[a-z]/{print $1}' | menu "profile (applies immediately)") && [ -n "$p" ] && { [ "$p" = standard ] && term "ns-secure disable" || term "ns-secure enable $p"; };;
      Custom*) custom;;
      "Emergency Disconnect") yesno "cut ALL network traffic now?" && term "ns-secure kill";;
      Release*) term "ns-secure release";;
      Verify*) term "ns-secure verify";;
      "View changes") term "ns-secure changes";;
      "Security log") term "ns-secure logs -n 200 | less -R";;
      "Network connections") term "ns-secure connections | less -S";;
      Listening*) term "ns-secure audit listening";;
      IP*) term "ns-secure routes";;
      MAC*) term "ns-secure mac";;
      Audits*) audits;;
      Labs*) labs;;
      Restore*) yesno "re-apply the current profile exactly as shipped?" && term "ns-secure restore";;
    esac
  done
}
main
