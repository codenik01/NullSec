#!/usr/bin/env bash
unset DESKTOP_STARTUP_ID
# sudo ns-session openbox|i3   (takes effect after logout)
[ "$1" = openbox ] || [ "$1" = i3 ] || { echo "usage: sudo ns-session openbox|i3"; exit 1; }
s=$1; C=/etc/lightdm/lightdm.conf.d/99-nullsec.conf
# 1) system default (the live session auto-login reads this). Add the key if it is missing instead of silently doing nothing.
mkdir -p "${C%/*}"; [ -f "$C" ] || printf '[Seat:*]\n' > "$C"
if grep -q '^user-session=' "$C"; then sed -i "s/^user-session=.*/user-session=$s/" "$C"; else sed -i "/^\[Seat:\*\]/a user-session=$s" "$C"; fi
# 2) the user's own saved session. On an installed system there is no auto-login: lightdm-gtk-greeter uses the session saved for
#    the user (AccountsService / ~/.dmrc), and that overrides user-session above, so the switch to floating never took effect.
u=${SUDO_USER:-}
if [ -n "$u" ] && [ "$u" != root ] && getent passwd "$u" >/dev/null; then
  f=/var/lib/AccountsService/users/$u; mkdir -p "${f%/*}"; [ -f "$f" ] || : > "$f"
  grep -q '^\[User\]' "$f" || printf '[User]\n' >> "$f"
  if grep -q '^XSession=' "$f"; then sed -i "s/^XSession=.*/XSession=$s/" "$f"; else sed -i "/^\[User\]/a XSession=$s" "$f"; fi
  h=$(getent passwd "$u" | cut -d: -f6)
  if [ -d "$h" ]; then printf '[Desktop]\nSession=%s\n' "$s" > "$h/.dmrc"; chown "$u": "$h/.dmrc"; fi
fi
echo "session set to $s; log out to apply"
