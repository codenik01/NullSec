#!/usr/bin/env python3
unset DESKTOP_STARTUP_ID
# Hyprland-like "dwindle": every new window splits the focused one along its longer side.
import i3ipc
i3 = i3ipc.Connection()
def on_focus(conn, e):
    w = conn.get_tree().find_focused()
    if not w or w.type != "con" or (w.floating and w.floating.endswith("_on")) or w.fullscreen_mode:
        return
    if w.parent and w.parent.layout in ("tabbed", "stacked"):
        return
    conn.command("split h" if w.rect.width >= w.rect.height else "split v")
i3.on("window::focus", on_focus)
i3.main()
