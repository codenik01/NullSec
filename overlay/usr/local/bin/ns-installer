#!/usr/bin/env bash
unset DESKTOP_STARTUP_ID
# NullOS graphical installer (Calamares). Only meaningful in the live session: it copies this live system to a disk.
# The security service and every setting come across; the live user 'ns' does not (you create your own account).
if ! grep -qw 'boot=casper' /proc/cmdline 2>/dev/null; then
  msg="The installer only runs from the live session. This system is already installed."
  echo "$msg" >&2; command -v notify-send >/dev/null && notify-send "NullOS installer" "$msg"; exit 1
fi
command -v calamares >/dev/null 2>&1 || { m="calamares is not part of this image (build without installer)"; echo "$m" >&2; command -v notify-send >/dev/null && notify-send "NullOS installer" "$m"; exit 127; }
[ -d /sys/firmware/efi ] && mode=UEFI || mode=BIOS
echo "Starting the NullOS installer ($mode boot). It will show a summary and ask before changing any disk."
# -E keeps DISPLAY/XAUTHORITY so the installer window can open as root
exec sudo -E calamares "$@"
